@page "/backup-check"
@inject HttpClient Http
<h1>Backup resilience check</h1><p>Toggle every risk that applies. The score reflects the weighted risks you selected.</p>
@if (questions is null) { <p>Loading questions…</p> } else { foreach(var q in questions){<label class="question"><input type="checkbox" @bind="answers[q.Id]" />@q.Text <small>(weight @q.Weight)</small></label>} <button @onclick="SubmitAsync">Calculate risk</button> }
@if(score.HasValue){<div class="card"><div class="gauge">Risk score: @score / 100</div><h2>Fix advice</h2><ul>@foreach(var fix in fixes){<li>@fix</li>}</ul></div>}
@code { private List<Question>? questions; private Dictionary<int,bool> answers=new(); private int? score; private List<string> fixes=new(); protected override async Task OnInitializedAsync(){questions=await Http.GetFromJsonAsync<List<Question>>("api/checklist/questions");if(questions is not null)foreach(var q in questions)answers[q.Id]=false;} private async Task SubmitAsync(){var r=await Http.PostAsJsonAsync("api/checklist/submit",new {answers=answers.ToDictionary(x=>x.Key.ToString(),x=>x.Value)});var data=await r.Content.ReadFromJsonAsync<Result>();score=data?.RiskScore;fixes=data?.Fixes??[];} private sealed class Question{public int Id{get;set;}public string Text{get;set;}="";public int Weight{get;set;}} private sealed class Result{public int RiskScore{get;set;}public List<string>? Fixes{get;set;}} }
