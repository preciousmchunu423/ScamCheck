@page "/cases"
@inject HttpClient Http
<h1>Scam case library</h1><div class="filters"><input @bind="search" @bind:event="oninput" placeholder="Search cases" /><select @bind="brand"><option value="">All brands</option>@foreach(var b in brands){<option>@b</option>}</select><button @onclick="LoadAsync">Search</button></div>
@if(cases is null){<p>Loading cases…</p>}else if(!cases.Any()){<p>No cases found.</p>}else{foreach(var c in cases){<article class="case"><h2>@c.Title</h2><p><strong>@c.Channel</strong> · @c.BrandImpersonated</p><p>@c.Description</p><ul class="flags">@foreach(var flag in c.RedFlags.Split('\n',StringSplitOptions.RemoveEmptyEntries)){<li>@flag</li>}</ul></article>}}
@code {private string search="",brand="";private List<Case>? cases;private readonly string[] brands=["Takealot","DStv","SARS","SAA","Courier","Fastway","DHL","RAM","Standard Bank","FNB","Absa","Nedbank","Capitec","MTN","Vodacom","Telkom","None","South African banks"];protected override Task OnInitializedAsync()=>LoadAsync();private async Task LoadAsync(){cases=await Http.GetFromJsonAsync<List<Case>>($"api/cases?q={Uri.EscapeDataString(search)}&brand={Uri.EscapeDataString(brand)}");}private sealed class Case{public string Title{get;set;}="";public string Channel{get;set;}="";public string BrandImpersonated{get;set;}="";public string Description{get;set;}="";public string RedFlags{get;set;}="";}}
