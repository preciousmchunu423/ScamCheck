@{ ViewData["Title"] = "ScamCheck"; }
<section class="hero">
    <h1>Is this link a scam?</h1>
    <p class="muted">Paste the link from the SMS or message</p>
    <form id="link-check-form">
        <input id="url" type="text" placeholder="takealot-sa.xyz/track" aria-label="Link to check" />
        <button class="primary" type="submit">Check link</button>
    </form>
    <p class="trust">Free. No account. Works in South Africa.</p>
</section>
<div id="check-result" class="result" hidden></div>
<div class="feature-list">
    <a class="feature" asp-action="Index"><strong>Check a link</strong><span>Paste it, get a result in seconds.</span></a>
    <a class="feature" asp-action="Cases"><strong>Search scam cases</strong><span>Real South African scams and their red flags.</span></a>
    <a class="feature" asp-action="Backup"><strong>Backup check</strong><span>Eight questions for small business owners.</span></a>
</div>
@section Scripts {
<script>
document.getElementById('link-check-form').addEventListener('submit', async function (event) {
    event.preventDefault();
    const result = document.getElementById('check-result');
    result.hidden = false; result.className = 'result'; result.textContent = 'Checking link…';
    try {
        const response = await fetch('/api/scam/check-link', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ url: document.getElementById('url').value }) });
        const data = await response.json();
        result.className = 'result ' + data.verdict;
        result.innerHTML = '<strong>' + (data.verdict === 'malicious' ? 'Known scam link' : data.verdict === 'suspicious' ? 'Suspicious link' : 'Not in our blacklist') + '</strong><p>' + data.advice + '</p>';
    } catch {
        result.className = 'result suspicious';
        result.innerHTML = '<strong>Offline</strong><p>Link checks require an internet connection.</p>';
    }
});
</script>
}
